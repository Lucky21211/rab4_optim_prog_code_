# Copy to .env; generate a long POSTGRES_PASSWORD and base64: APP_KEY.
POSTGRES_DB=monolith
POSTGRES_USER=monouser
POSTGRES_PASSWORD=
APP_KEY=
WEB_PORT=8080
RUST_PORT=8081
NASA_API_KEY=
JWST_API_KEY=
JWST_EMAIL=
ASTRO_APP_ID=
ASTRO_APP_SECRET=
