NEO_EVERY_SECONDS=7200
DONKI_EVERY_SECONDS=3600
SPACEX_EVERY_SECONDS=3600
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=2
RATE_LIMIT_MS=1000
SCHEDULER_ENABLED=true
LEGACY_CRON=*/5 * * * *
READ_CACHE_TTL=10
GALLERY_CACHE_TTL=120
CMS_CACHE_TTL=60
